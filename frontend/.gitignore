# ==========================================
# BiteBack Project Root .gitignore
# ==========================================

# Core OS files
.DS_Store
Thumbs.db
*.log
*.local

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.bloop
.metals

# ==========================================
# Backend (Python / FastAPI / SQLAlchemy)
# ==========================================

# Virtual Environments
backend/venv/
backend/env/
backend/ENV/
backend/.venv/

# Python caching & bytecode
backend/**/__pycache__/
backend/**/*.py[cod]
backend/*$py.class

# Local configurations & variables
backend/.env
backend/pyrightconfig.json

# Database & SQLite files
backend/*.db
backend/*.sqlite3

# Distribution / packaging
backend/develop-eggs/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/pip-wheel-metadata/
backend/share/python-wheels/
backend/*.egg-info/
backend/.installed.cfg
backend/*.egg

# ==========================================
# Frontend (React / Next.js / Vite)
# ==========================================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Testing
frontend/coverage/

# Production builds
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Local configuration files & environments
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Log files
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Editor directories
frontend/.eslintcache
frontend/.stylelintcache

# Vercel / Netlify build directories
frontend/.vercel
frontend/.netlify
