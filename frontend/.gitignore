 ==========================================
# BiteBack Project Root .gitignore
# ==========================================

# Core OS files
.DS_Store
Thumbs.db
*.log
*.local

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.bloop
.metals

# ==========================================
# Backend (Python / FastAPI / SQLAlchemy)
# ==========================================

# Virtual Environments
backend/venv/
backend/env/
backend/ENV/
backend/.venv/

# Python caching & bytecode
backend/**/__pycache__/
backend/**/*.py[cod]
backend/*$py.class

# Local configurations & variables
backend/.env
backend/pyrightconfig.json

# Database & SQLite files
backend/*.db
backend/*.sqlite3

# Distribution / packaging
backend/develop-eggs/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/pip-wheel-metadata/
backend/share/python-wheels/
backend/*.egg-info/
backend/.installed.cfg
backend/*.egg

# ==========================================
# Frontend (React / Next.js / Vite)
# ==========================================

# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Testing
frontend/coverage/

# Production builds
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Local configuration files & environments
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Log files
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Editor directories
frontend/.eslintcache
frontend/.stylelintcache

# Vercel / Netlify build directories
frontend/.vercel
frontend/.netlify
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#t-store)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node_modules
node_modules
jspm_packages

# TypeScript v1 declaration files
typings

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file (keep local secrets out of git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Vite build output
dist
dist-ssr

# Next.js build output (if applicable)
.next
out

# Nuxt.js build / generate output (if applicable)
.nuxt
.output

# Gatsby files (if applicable)
.cache/
public

# Storybook build outputs
storybook-static

# IDEs and editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
